{
	"name": "@adiwajshing/eslint-config",
	"version": "3.0.0",
	"files": [
		"oxlint.config.ts",
		"oxfmt.config.ts"
	],
	"type": "module",
	"main": "oxlint.config.ts",
	"scripts": {
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint && npm run format:check",
		"lint:fix": "oxlint --fix && npm run format"
	},
	"devDependencies": {
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"oxfmt": "*",
		"oxlint": "*"
	}
}
